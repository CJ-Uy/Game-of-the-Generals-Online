{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gogo-room-sync",
	"account_id": "8527ec1369d46f55304a6f59ab5356e4",
	"main": "workers/room-sync.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "sync.gogo.cjuy.dev",
			"custom_domain": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM_SYNC",
				"class_name": "RoomSync"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RoomSync"]
		}
	],
	"d1_databases": [
		{
			"binding": "GOGO_DB",
			"database_name": "gogo-db",
			"database_id": "4929c8fd-3fdd-4839-9ae1-8f49bc2943e3",
			"migrations_dir": "drizzle"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
